{
  "name": "domainclash",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node --import tsx --test tests/*.test.mjs",
    "server": "tsx server/index.mjs",
    "start": "tsx server/index.mjs",
    "deploy": "npm run build && wrangler deploy",
    "dev:cloudflare": "wrangler dev --port 8788"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.141.0"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "ws": "^8.22.0"
  }
}
